# Public site identity
NEXT_PUBLIC_SITE_URL=https://www.zk-home.com
NEXT_PUBLIC_BASE_URL=https://www.zk-home.com

# New Supabase/PostgreSQL project (leave empty until provisioned)
DATABASE_URL=
DATABASE_POOL_MAX=1
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# Generate new independent secrets for ZK Home
ADMIN_JWT_SECRET=
CUSTOMER_JWT_SECRET=
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
CRON_SECRET=
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@zk-home.com
ADMIN_TOTP_SECRET=

# Persistent media storage (configure Supabase Storage or another S3 provider)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Integrations stay disabled until new ZK Home credentials are created
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
BIRFATURA_API_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_ACCOUNT_ID=
GEMINI_API_KEY=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=
TRANSACTIONAL_EMAIL_REPLY_TO=

# Optional external commerce backend
MEDUSA_BACKEND_URL=
MEDUSA_ADMIN_URL=

# Set to 1 only during the initial empty-database setup
RUN_SCHEMA_BOOTSTRAP=0
STORE_READY=false
